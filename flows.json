    {
        "id": "033d4c2e94209c8f",
        "type": "function",
        "z": "a96f03b406983529",
        "name": "Voltage Wave Points",
        "func": "// Turn one mains cycle (array of samples) into SVG polyline points.\n// Auto-scales, but never below +/- FLOOR so noise is not blown up.\nvar d = msg.payload;\nvar FLOOR = 10;\nvar peak = FLOOR, i;\n\nfor (i = 0; i < d.length; i++) { if (Math.abs(d[i]) > peak) peak = Math.abs(d[i]); }\npeak = peak * 1.1;\n\nvar pts = [];\nfor (i = 0; i < d.length; i++) {\n    var x = i * 400 / (d.length - 1);\n    var y = 70 - (d[i] / peak) * 65;\n    pts.push(x.toFixed(1) + ',' + y.toFixed(1));\n}\n\nreturn { payload: { pts: pts.join(' '), rng: peak.toFixed(peak < 1 ? 2 : 1) } };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 460,
        "wires": [
            [
                "6d7a78667e56fbf5"
            ]
        ]
