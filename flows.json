        "type": "function",
        "z": "a96f03b406983529",
        "name": "Validate & Send",
        "func": "// Runs when Send is pressed. Validates BEFORE anything goes to the hardware.\nvar MAX_POS = 4;     // = NUM_SECTIONS - 1 in the firmware (keep in sync)\n\nvar v = flow.get('pendingPos');\n\nif (v === undefined || v === null || isNaN(v)) {\n    return [null, { payload: 'Nothing to send - choose a position first' }];\n}\nif (!Number.isInteger(v) || v < 0 || v > MAX_POS) {\n    return [null, { payload: 'Invalid position ' + v + ' (allowed 0 to ' + MAX_POS + ') - not sent' }];\n}\n\nreturn [\n    { payload: 'POS,' + v + '\\n' },\n    { payload: 'Sent position ' + v + ' - waiting for ESP32 confirmation' }\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
