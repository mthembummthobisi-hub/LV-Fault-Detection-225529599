    {
        "id": "c0nd0000hold0001",
        "type": "function",
        "z": "a96f03b406983529",
        "name": "Hold Conductors",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 1130,
        "wires": [
            [
                "c0nd0000dd00001"
            ],
            [
                "c0nd0000dd00002"
            ],
            [
                "c0nd0000dd00003"
            ],
            [
                "c0nd0000dd00004"
            ],
            [
                "c0nd0000dd00005"
            ],
            [
                "c0nd0000dd00000"
            ],
            [
                "c0nd0000stat0001"
            ]
        ],
        "func": "// Conductor selections are only HELD here - nothing is sent to the ESP32\n// until the Send conductors button is pressed.\n// Inputs : msg.topic = 'whole' | 'sec1'..'sec5', msg.payload = conductor index\n// Outputs: 0-4 = Section 1-5 dropdowns | 5 = Whole-line dropdown | 6 = status text\nvar NUM_SECTIONS   = 5;\nvar NUM_CONDUCTORS = 6;      // keep in sync with the firmware catalog\n\nvar pending = flow.get('pendingConductors') || [0, 0, 0, 0, 0];\nvar idx = Number(msg.payload);\n\n// Selecting \"(mixed)\" on the whole-line dropdown is only a display state\nif (msg.topic === 'whole' && idx === -1) return null;\n\n// Client-side validation: integer inside the catalog range\nif (!Number.isInteger(idx) || idx < 0 || idx >= NUM_CONDUCTORS) {\n    return [null, null, null, null, null, null,\n            { payload: 'Invalid conductor selection - ignored' }];\n}\n\nvar out = [null, null, null, null, null, null, null];\n\nif (msg.topic === 'whole') {\n    // Whole-line choice fills every section (still pending, not sent)\n    pending = [idx, idx, idx, idx, idx];\n    for (var k = 0; k < NUM_SECTIONS; k++) out[k] = { payload: idx };\n}\nelse {\n    var m = /^sec([1-5])$/.exec(msg.topic);\n    if (!m) return null;                       // unknown source, ignore\n    pending[Number(m[1]) - 1] = idx;           // single-section override\n\n    // Whole-line dropdown shows the common type, or \"(mixed)\"\n    var same = pending.every(function (v) { return v === pending[0]; });\n    out[5] = { payload: same ? pending[0] : -1 };\n}\n\nflow.set('pendingConductors', pending);\nout[6] = { payload: 'Pending: ' + pending.join(', ') + '  (not sent - press Send)' };\nreturn out;\n"
    },
    {
        "id": "c0nd0000btn00001",
        "type": "ui_button",
        "z": "a96f03b406983529",
        "name": "Send Conductors",
        "group": "c0nd0000grp00001",
        "order": 7,
        "width": "6",
        "height": "1",
        "passthru": false,
        "label": "Send conductors",
        "tooltip": "",
        "color": "",
        "bgcolor": "",
        "className": "",
        "icon": "",
        "payload": "send",
        "payloadType": "str",
        "topic": "",
        "topicType": "str",
        "x": 140,
        "y": 1310,
        "wires": [
            [
                "c0nd0000send0001"
            ]
        ]
    },
    {
        "id": "c0nd0000send0001",
        "type": "function",
        "z": "a96f03b406983529",
        "name": "Validate & Send Conductors",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 1310,
        "wires": [
            [
                "6df7433ba357f278"
            ],
            [
                "c0nd0000stat0001"
            ]
        ],
        "func": "// Runs when Send conductors is pressed. Validates BEFORE anything goes\n// to the hardware, then sends ONE atomic command (ESP32 applies all 5 or none).\nvar NUM_SECTIONS   = 5;\nvar NUM_CONDUCTORS = 6;      // keep in sync with the firmware catalog\n\nvar pending = flow.get('pendingConductors');\n\nif (!Array.isArray(pending)) {\n    return [null, { payload: 'Nothing to send - choose a conductor first' }];\n}\n\nvar ok = pending.length === NUM_SECTIONS && pending.every(function (v) {\n    return Number.isInteger(v) && v >= 0 && v < NUM_CONDUCTORS;\n});\nif (!ok) {\n    return [null, { payload: 'Invalid selection (' + pending.join(', ') + ') - not sent' }];\n}\n\nreturn [\n    { payload: 'CONDALL,' + pending.join(',') + '\\n' },\n    { payload: 'Sent: ' + pending.join(', ') + ' - waiting for ESP32 confirmation' }\n];\n"
    },
    {
        "id": "c0nd0000sync0001",
        "type": "function",
        "z": "a96f03b406983529",
        "name": "Sync Conductors",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 1400,
        "wires": [
            [
                "c0nd0000dd00001"
            ],
            [
                "c0nd0000dd00002"
            ],
            [
                "c0nd0000dd00003"
            ],
            [
                "c0nd0000dd00004"
            ],
            [
                "c0nd0000dd00005"
            ],
            [
                "c0nd0000dd00000"
            ],
            [
                "c0nd0000stat0001"
            ]
        ],
        "func": "// The ESP32 reports the conductor setup it is actually USING (LINE message).\n// Show it on the dropdowns and make it the new pending value.\n// Outputs: 0-4 = Section 1-5 dropdowns | 5 = Whole-line dropdown | 6 = status text\nvar c = msg.payload.conds;\nvar same = c.every(function (v) { return v === c[0]; });\n\nflow.set('appliedConductors', c);\nflow.set('pendingConductors', c.slice());     // pending = applied\n\nreturn [\n    { payload: c[0] }, { payload: c[1] }, { payload: c[2] },\n    { payload: c[3] }, { payload: c[4] },\n    { payload: same ? c[0] : -1 },\n    { payload: 'Applied: ' + c.join(', ') }\n];\n"
    },
    {
        "id": "c0nd0000fmt00001",
        "type": "function",
        "z": "a96f03b406983529",
        "name": "Format Line Details",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 1480,
        "wires": [
            [
                "c0nd0000det00001"
            ]
        ],
        "func": "// Collect the 5 SEC lines (one per section): conductor name + its ohm/km rating.\nvar t = context.get('table') || [];\nvar s = msg.payload;\nt[s.sec - 1] = 'S' + s.sec + ' ' + s.name + ' ' + s.ohmPerKm.toFixed(4) + ' ohm/km';\ncontext.set('table', t);\n\n// Only show once every section has reported at least once\nfor (var i = 0; i < 5; i++) { if (!t[i]) return null; }\nreturn { payload: t.join('  |  ') };\n"
    },
    {
        "id": "c0nd0000stat0001",
        "type": "ui_text",
        "z": "a96f03b406983529",
        "group": "c0nd0000grp00001",
        "order": 8,
        "width": "12",
        "height": "1",
        "name": "Conductor Status",
        "label": "Conductors",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 700,
        "y": 1310,
        "wires": []
    },
    {
        "id": "c0nd0000det00001",
        "type": "ui_text",
        "z": "a96f03b406983529",
        "group": "c0nd0000grp00001",
        "order": 9,
        "width": "12",
