    {
        "id": "34b29ce607b2b2f3",
        "type": "function",
        "z": "a96f03b406983529",
        "name": "Parse Line",
        "func": "// Route one serial line from the ESP32 to the right output.\n// Outputs: 0 LIVE | 1 WV | 2 WI | 3 FAULT | 4 COV | 5 event log\n//          6 LINE (applied conductor setup) | 7 SEC (per-section details)\nvar s = String(msg.payload).trim();\nif (s.length === 0) return null;\n\nvar p = s.split(',');\nvar tag = p[0];\nvar out = [null, null, null, null, null, null, null, null];\n\nif (tag === 'LIVE' && p.length >= 11) {\n    out[0] = { payload: {\n        v: parseFloat(p[1]), i: parseFloat(p[2]), z: parseFloat(p[3]),\n        state: p[4], faults: parseInt(p[5], 10),\n        pos: parseInt(p[6], 10), vis: parseInt(p[7], 10),\n        expI: parseFloat(p[8]), expZ: parseFloat(p[9]),\n        zValid: parseInt(p[10], 10) === 1\n    } };\n}\nelse if (tag === 'WV' || tag === 'WI') {\n    // One whole mains cycle per line: WV,s1,s2,...,s20\n    var data = p.slice(1).map(Number).filter(function (n) { return !isNaN(n); });\n    if (data.length >= 2) out[tag === 'WV' ? 1 : 2] = { payload: data };\n}\nelse if (tag === 'FAULT' && p.length >= 7) {\n    // v7 FAULT layout:\n    // FAULT,section,distM,V,I,count,Z,condIdx,condName,distKm,ohmPerKm,modelM\n    // The conductor fields describe the section that CONTAINS the fault.\n    var f = {\n        section: parseInt(p[1], 10), dist: parseFloat(p[2]),\n        v: parseFloat(p[3]), i: parseFloat(p[4]),\n        count: parseInt(p[5], 10), z: parseFloat(p[6]),\n        cond: (p.length >= 12) ? p[8] : '',\n        distKm: (p.length >= 12) ? parseFloat(p[9]) : parseFloat(p[2]) / 1000\n    };\n    out[3] = { payload: f };\n\n    // The ESP32 repeats the FAULT line while faulted: log each fault once\n    if (context.get('lastFault') !== f.count) {\n        context.set('lastFault', f.count);\n        out[5] = { payload: 'FAULT #' + f.count + ' at ' + f.distKm.toFixed(3) +\n                   ' km (near S' + f.section + (f.cond ? ', ' + f.cond : '') +\n                   '), I=' + f.i.toFixed(3) + ' A, Z=' + f.z.toFixed(1) + ' ohm' };\n    }\n}\nelse if (tag === 'FAULT_CLEAR') {\n    out[3] = { payload: { clear: true } };\n}\nelse if (tag === 'COV' && p.length >= 4) {\n    out[4] = { payload: { pos: parseInt(p[1], 10), vis: parseInt(p[2], 10),\n                          text: p.slice(3).join(',') } };\n}\nelse if (tag === 'LINE' && p.length >= 6) {\n    // LINE,i1,i2,i3,i4,i5  = conductor setup the ESP32 is USING\n    out[6] = { payload: { conds: p.slice(1, 6).map(Number) } };\n}\nelse if (tag === 'SEC' && p.length >= 6) {\n    // SEC,n,idx,name,ohmPerKm,areaMm2  (one per section)\n    out[7] = { payload: {\n        sec: parseInt(p[1], 10), idx: parseInt(p[2], 10), name: p[3],\n        ohmPerKm: parseFloat(p[4]), areaMm2: parseFloat(p[5])\n    } };\n}\nelse if (tag === 'EVT') {\n    out[5] = { payload: p.slice(1).join(',') };\n}\nelse if (tag === 'WARN' || tag === 'ERR') {\n    out[5] = { payload: tag + ': ' + p.slice(1).join(',') };\n}\nelse if (tag === 'ACK') {\n    out[5] = { payload: 'ESP32 confirmed: ' + p.slice(1).join(' ') };\n}\n// CAT lines (conductor catalog) are ignored: the dropdown options are\n// fixed in the dashboard and must match the firmware catalog order.\n\nreturn out;\n",
        "outputs": 8,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
