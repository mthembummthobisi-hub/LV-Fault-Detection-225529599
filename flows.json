        "format": "<div style=\"width:100%;\">\n  <div style=\"font-size:13px;opacity:.75;\">Voltage waveform (one cycle) <span ng-if=\"msg.payload.rng\">(range +/- {{msg.payload.rng}} V)</span></div>\n  <svg viewBox=\"0 0 400 140\" style=\"width:100%;height:auto;\">\n    <line x1=\"0\" y1=\"70\" x2=\"400\" y2=\"70\" stroke=\"#888\" stroke-width=\"0.6\" stroke-dasharray=\"3,3\"></line>\n    <polyline ng-attr-points=\"{{msg.payload.pts}}\" fill=\"none\" stroke=\"#1f77b4\" stroke-width=\"2\"></polyline>\n  </svg>\n</div>",
