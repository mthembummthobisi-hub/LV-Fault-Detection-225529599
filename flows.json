    {
        "id": "ae9d854380dd0cc4",
        "type": "function",
        "z": "a96f03b406983529",
        "name": "Fault Display",
        "func": "// Shows fault details ONLY while a fault is active.\n// Inputs: FAULT data, FAULT_CLEAR, and every LIVE reading.\nvar d     = msg.payload;\nvar last  = context.get('last')  || null;\nvar state = context.get('state') || '';\n\nif (d.clear === true) {\n    last = null;                         // ESP32 says the fault is gone\n}\nelse if (d.section !== undefined) {\n    last = d;                            // new / updated fault data\n}\nelse if (d.state !== undefined) {        // a normal LIVE reading\n    state = d.state;\n    if (state === 'NORMAL') last = null; // healthy again -> clear (backup)\n}\ncontext.set('last', last);\ncontext.set('state', state);\n\nvar sec, dist, val;\nif (last) {\n    sec  = 'S' + last.section;\n    // v7: distance is conductor-based (km), walked section by section\n    dist = last.distKm.toFixed(3) + ' km';\n    val  = last.i.toFixed(3) + ' A   |   ' + last.z.toFixed(1) + ' ohm' +\n           (last.cond ? '   |   ' + last.cond : '');\n    if (state === 'NO_SUPPLY') sec += '  (last fault, supply lost)';\n} else {\n    sec  = 'No fault';\n    dist = '--';\n    val  = '--';\n}\n\n// Only update the screen when something changed\nvar key = sec + '|' + dist + '|' + val;\nif (context.get('key') === key) return null;\ncontext.set('key', key);\n\nreturn [ { payload: sec }, { payload: dist }, { payload: val } ];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
