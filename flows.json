    {
        "id": "9b5491656a321ab0",
        "type": "function",
        "z": "a96f03b406983529",
        "name": "Split LIVE",
        "func": "// Split one LIVE reading into separate messages.\n// Gauges and charts move from msg.payload, so each gets its own number.\nvar d = msg.payload;\n\n// While healthy the line carries only about 0.04 A - below what the ACS712\n// can resolve - so current and impedance are shown as CALCULATED values\n// (from the known resistances). During a fault the current is large and\n// the MEASURED values are shown automatically.\nvar measurable = d.zValid;\n\nvar iShown = measurable ? d.i : d.expI;\nvar zShown = measurable ? d.z : d.expZ;\nvar note   = measurable\n    ? 'Current and impedance shown: measured'\n    : 'Current and impedance shown: calculated from the known resistances (healthy current is below sensor resolution)';\n\n// No supply: nothing is flowing\nif (d.v < 5) {\n    iShown = 0;\n    zShown = 0;\n    note   = 'No supply';\n}\n\nreturn [\n    { payload: d.v,      topic: 'Voltage' },\n    { payload: iShown,   topic: 'Current' },\n    { payload: zShown },\n    { payload: d.faults },\n    { payload: d.expI.toFixed(4) + ' A' },\n    { payload: note }\n];",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
