    {
        "id": "0f1d2efb9e74997a",
        "type": "function",
        "z": "a96f03b406983529",
        "name": "Status Banner Data",
        "func": "// Big coloured status banner, driven by the ESP32 state\nvar d = msg.payload;\n\nvar text = {\n    BOOT:      'STARTING...',\n    WAIT_OFF:  'SWITCH SUPPLY OFF TO CALIBRATE',\n    CAL:       'CALIBRATING...',\n    WAIT_ON:   'SWITCH SUPPLY ON',\n    NORMAL:    'NORMAL OPERATION',\n    SUSPECT:   'CHECKING - POSSIBLE FAULT',\n    FAULT:     'FAULT DETECTED',\n    NO_SUPPLY: 'NO SUPPLY'\n}[d.state] || d.state;\n\nvar colour = '#616161';                                  // grey: setup / waiting\nif (d.state === 'NORMAL')         colour = '#2e7d32';    // green\nelse if (d.state === 'SUSPECT')   colour = '#f9a825';    // amber\nelse if (d.state === 'FAULT')     colour = '#c62828';    // red\nelse if (d.state === 'NO_SUPPLY') colour = '#ef6c00';    // orange\n\nreturn { payload: { state: d.state, text: text, colour: colour } };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 40,
